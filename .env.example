# The dashboard starts in fixture mode so the UI works without infrastructure.
DATA_MODE=fixture

# Set DATA_MODE=clickhouse after starting the local stack.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=otel
CLICKHOUSE_DATABASE=telemetry

# The instrumented checkout service exports OTLP/HTTP to the Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=checkout-api
DEMO_SERVICE_URL=http://localhost:4000
